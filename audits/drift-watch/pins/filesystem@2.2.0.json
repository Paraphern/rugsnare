              "dryRun": {
                "default": false,
                "description": "Preview changes using git-style diff format",
                "type": "boolean"
              },
              "edits": {
                "items": {
                  "properties": {
                    "newText": {
                      "description": "Text to replace with",
                      "type": "string"
                    },
                    "oldText": {
                      "description": "Text to search for - must match exactly",
                      "type": "string"
                    }
                  },
                  "required": ["oldText","newText"],
                  "type": "object"
                },
                "type": "array"
              },
              "path": {
                "type": "string"
              }
            },
            "required": ["path","edits"],
            "type": "object"
          },
