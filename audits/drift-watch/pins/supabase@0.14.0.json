        "create_branch": {
          "annotations": {
            "destructiveHint": false,
            "idempotentHint": false,
            "openWorldHint": false,
            "readOnlyHint": false,
            "title": "Create branch"
          },
          "approved": true,
          "description": "Creates a development branch on a Supabase project, which can incur hourly compute and other usage charges. The user must agree to the cost before the branch is created. Unless `confirm_cost_id` is required, call this tool without it and without asking for cost confirmation in chat first. The server handles cost confirmation, or returns instructions for obtaining a confirmation ID. If it requests an ID, follow those instructions and retry with it. This will apply all migrations from the main project to a fresh branch database. Note that production data will not carry over. The branch will get its own project_id via the resulting project_ref. Use this ID to execute queries and migrations on the branch.",
          "firstSeen": "2026-10-24T18:26:52.955Z",
          "hash": "49e3a41c606804073c26180b22dcfc87bba8af1b658ff5648cbe1f217077f65f",
          "inputSchema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "additionalProperties": false,
            "properties": {
              "confirm_cost_id": {
                "description": "The ID returned by `confirm_cost`. To get it, call `get_cost`, tell the user the cost, and call `confirm_cost` once they agree.",
                "type": "string"
              },
              "name": {
                "default": "develop",
                "description": "Name of the branch to create",
                "type": "string"
              },
              "project_id": {
                "type": "string"
              }
            },
            "required": ["project_id","name","confirm_cost_id"],
            "type": "object"
          },
          "pinnedAt": "2026-10-24T18:27:05.314Z",
          "proseHash": "eb2b6857dd536d090677cd201e8104e06d64ad396cd03468b20e7e807a34f6f8",
