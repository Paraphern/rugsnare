# rugsnare runtime state (pins may be committed deliberately — the CI-gate
# workflow expects the baseline pins in the repo; demos commit theirs too)
.demo/
**/.rugsnare/*
!**/.rugsnare/pins.json
!**/.rugsnare/pins.sig
!**/.rugsnare/pins.pub.pem
.zcodeignore

# Go native launcher build artifacts (sources are public, binaries ship via GitHub Releases)
native/bin/
native/rugsnare-skills.exe

# goversioninfo experiment output (rejected by Go 1.27 linker; icon-only syso IS committed)
native/test-version.syso

# local toolchains (installed per-machine, never needed by CI; see native/README)
/tools/go/
/tools/gobin/
/tools/*.zip
# wrangler local state (contains account ids)
.wrangler/
audits/.weekly-work/
